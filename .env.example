# ============================================================
# 瞬间 · 部署配置
# 用法：./install.sh  （会自动把本文件复制成 .env 并补齐随机凭据）
# 想手动改：先 cp .env.example .env，再把下面留空的项填上
# 注意：.env 不进 git、不进镜像，权限建议 600
# ============================================================

# ---------- 对外访问 ----------
# 整个包只暴露这一个端口，浏览器访问 http://<主机IP>:8080
PORT=8080
# 时区：四个容器统一使用，决定 0:00 备份 / 3:00 清理按哪个时区执行
TZ=Asia/Shanghai
# 站点名，显示在登录页与浏览器标题
SITE_NAME=瞬间

# ---------- 数据目录（宿主机路径）----------
# 图片、视频、压缩缩略图都在这里，换机器/恢复时要连它一起带走
UPLOADS_DIR=./data/uploads
# 每日导出的数据库 JSON 存这里（只含数据库，不含图片）
BACKUPS_DIR=./data/backups

# ---------- 预置管理员（可选）----------
# 两项都填：首次启动自动建管理员，并跳过 /setup 向导
# 留空：首次打开网页走向导注册
# 限制：用户名 2~30 字，密码至少 6 位（不满足会启动失败）
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- 上传上限 ----------
# 同时用于 nginx 与后端，单位 MB
MAX_UPLOAD_MB=100

# ---------- 内部组件凭据（install.sh 自动随机生成）----------
# 已经初始化过数据卷后不要再改这里：MONGO_INITDB_* 只在首次建库生效，
# 改了会导致 app 连不上；确需修改请进容器改库内用户，或删卷重建。
MONGO_USER=wink
MONGO_PASSWORD=
REDIS_PASSWORD=

# ---------- 运行容器的用户（install.sh 自动填当前用户）----------
# 保证上传目录里的文件属主与宿主机一致，宿主机上也能直接管理这些文件
APP_UID=
APP_GID=

# ---------- 镜像版本 ----------
MONGO_IMAGE=mongo:7
REDIS_IMAGE=redis:7-alpine

# ---------- 应用镜像（可选覆盖）----------
# install.sh 默认从 Docker Hub 拉取 yipanzwx/wink-app、yipanzwx/wink-web；
# 想锁定版本或用自建镜像时改这里（镜像都同时发布 <版本> 与 latest 两个 tag）
# APP_IMAGE=yipanzwx/wink-app:1.0.0
# WEB_IMAGE=yipanzwx/wink-web:1.0.0
